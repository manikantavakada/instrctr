datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Application {
  id                   Int      @id @default(autoincrement())
  name                 String
  phone                String
  email                String
  city                 String
  area                 String
  vehicles             String
  licenceNumber        String
  documentPath         String?
  documentOriginalName String?
  notes                String?
  status               String   @default("pending")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model LearnerInquiry {
  id        Int      @id @default(autoincrement())
  name      String?
  phone     String
  email     String?
  city      String?
  program   String?
  notes     String?
  createdAt DateTime @default(now())
}
